{
  "name": "paritins-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 7000",
    "build": "next build",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:backup": "node --env-file-if-exists=.env.local scripts/backup.mjs",
    "test:deploy": "node --test scripts/deploy.test.mjs"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
